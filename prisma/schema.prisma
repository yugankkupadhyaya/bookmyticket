generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String
  casts         String[]
  trailerUrl    String
  language      String         @default("English")
  releaseStatus String         @default("Released")
  theatres      MovieTheatre[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Theatre {
  id          String         @id @default(uuid())
  name        String
  description String?
  pincode     Int
  address     String
  city        String
  rating      Float          @default(0)
  movies      MovieTheatre[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([city])
  @@index([pincode])
}

model MovieTheatre {
  movieId   String
  theatreId String
  movie     Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  theatre   Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)

  @@id([movieId, theatreId])
  @@index([theatreId])
}

model User {
 name       String @unique
 email      String @unique
 password   String 
 userRole   String @default("CUSTOMER")
 userStatus String @default("APPROVED")

 createdAt  DateTime @default(now())
 updatedAt  DateTime @updatedAt

}


